#!name=麦当劳
#!desc=拦截麦当劳开屏排期（返回空日程 data.list=[]）与首页活动弹窗广告；保留点餐、会员与正常业务接口。
#!category=Proxy Suite
#!icon=https://fastly.jsdelivr.net/gh/AnTong-Git/Proxy_Suite_Modules@main/icons/McDonalds.png
#!homepage=https://github.com/AnTong-Git/Proxy_Suite_Modules
#!raw-url=https://raw.githubusercontent.com/AnTong-Git/Proxy_Suite_Modules/main/shadowrocket/McDonalds.srmodule

[Map Local]
# 开屏排期
^https://api\.mcd\.cn/bff/portal/home/splash(?:\?[^#]*)?$ data-type=base64 data="eyJjb2RlIjoyMDAsImRhdGEiOnsibGlzdCI6W119LCJzdWNjZXNzIjp0cnVlfQ==" status-code=200 header="Content-Type:application/json"
# 首页活动弹窗
^https://api\.mcd\.cn/bff/portal/richpop/v2(?:\?[^#]*)?$ data-type=base64 data="eyJjb2RlIjoyMDAsImRhdGEiOnt9LCJzdWNjZXNzIjp0cnVlfQ==" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.mcd.cn
