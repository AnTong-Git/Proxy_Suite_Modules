name: '麦当劳'
desc: '拦截麦当劳开屏排期（返回空日程 data.list=[]）与首页活动弹窗广告；保留点餐、会员与正常业务接口。'
icon: https://fastly.jsdelivr.net/gh/AnTong-Git/Proxy_Suite_Modules@main/icons/McDonalds.png
category: 'Proxy Suite'
homepage: https://github.com/AnTong-Git/Proxy_Suite_Modules
raw-url: https://raw.githubusercontent.com/AnTong-Git/Proxy_Suite_Modules/main/stash/McDonalds.stoverride

http:
  mitm:
    - 'api.mcd.cn'
  mock:
    # 开屏排期
    - match: '^https://api\.mcd\.cn/bff/portal/home/splash(?:\?[^#]*)?$'
      status-code: 200
      headers:
        Content-Type: 'application/json'
      text: '{"code":200,"data":{"list":[]},"success":true}'
    # 首页活动弹窗
    - match: '^https://api\.mcd\.cn/bff/portal/richpop/v2(?:\?[^#]*)?$'
      status-code: 200
      headers:
        Content-Type: 'application/json'
      text: '{"code":200,"data":{},"success":true}'
